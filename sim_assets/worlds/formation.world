<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="formation">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 物理参数必须和 PX4 自带 empty.world / ego_sim.world 保持一致, 特别
         是 <magnetic_field>: 少了它 Gazebo 的 fake mag 输出无效 -> EKF2 报
         "Preflight Fail: Yaw estimate error" -> PX4 拒绝解锁.
         多机时每架都要能解锁, 所以这里一个都不能少. -->
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <gui>
      <camera name="user_camera">
        <pose>-14 -16 10 0 0.38 2.4</pose>
      </camera>
    </gui>


    <model name="pillar_p8">
      <static>true</static>
      <pose>4 8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_pm8">
      <static>true</static>
      <pose>4 -8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_w6">
      <static>true</static>
      <pose>-8 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
