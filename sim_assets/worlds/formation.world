    <model name="pillar_wm6">
      <static>true</static>
      <pose>-8 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <!-- ==================== OBSTACLES:BEGIN (本区块由 scripts/gen_formation_world.py 生成, 不要手改) ==================== -->
    <!-- 生成参数: seed=20261013  min_gap=1.2  jitter=0.15  darts=1500  big_frac=0.08  rmax=0.8  spacing=2.30 (完整命令见生成时的 stdout) -->
    <!-- 参数: seed=20261013  min_gap=1.20 m  柱子数=77 (本区块新增 73 + 区块外原有 4) -->
    <!-- 候选点统计: 候选点=1599  跳过(留空)=278  放不下=1248  大树=81 -->
    <!-- 半径: 最小 0.20 m / 平均 0.39 m / 最大 0.77 m ; 障碍占地覆盖率 7.4% -->
    <!-- 全场最小表面缝 = 1.200 m ; 可飞临界 1.4 m = 膨胀 0.2x2 + 机体宽 0.7 + 余量 -->
    <!-- 布局: 抖动网格 + 密度场随机留空 (聚簇处更密更粗); 原起飞区 x[-1.8,1.8] y[-1.8,9.8] 与集结空地 P_集结空地 x[3.6,12.6] y[-3.4,4.6] 已挖空 -->
    <!-- 想换布局或看俯视图, 重跑 scripts/gen_formation_world.py 即可 (dry run 只看不写) -->

    <!-- 区块外原有 4 根柱子 (pillar_p8/pm8/w6/wm6, 在上面的手写区里) 原样保留, 它们已经算进全场最小缝和避让保证了, 这里不再重复写一遍 -->
    <!-- 以下 73 根新柱子: 抖动网格铺底 + 密度场随机留空 + 随机飞镖填缝 -->
