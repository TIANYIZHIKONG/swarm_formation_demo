<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="ego_sim">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 物理参数必须和 PX4 自带 empty.world 保持一致，特别是 <magnetic_field>：
         少了它 Gazebo 的磁力计(fake mag)输出无效 ->
         EKF2 报 "Preflight Fail: Yaw estimate error" -> PX4 拒绝解锁。 -->
    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>

    <gui>
      <camera name="user_camera">
        <pose>-8 -14 8 0 0.35 2.6</pose>
      </camera>
    </gui>

    <!-- ================== 障碍物 ==================
         布局设计：ego_planner 只有 7.5 m 前视距离，是"局部"规划器，
         所以不要设计"必须绕行超长墙"的场景，而要设计"必须穿门洞"的场景。

                 x = -5              x = +5
                   |                    |     两道横墙，各在 y∈[-1.5, 1.5]
        y=0  ......+......> 0 ......>  +......> 留 3 m 门洞，航线沿 y=0 直飞
                   |                    |
             (-8, ±4)  (0, ±6) 柱子   (8, ±4) 柱子

         默认航点: (8,0,1) 到 (-8,0,1) 到 (0,0,1)
         即: 出发点 -> 穿东侧门洞 -> 折返穿东西两道门洞 -> 回原点。
         机身宽约 0.5 m，门洞 3 m，膨胀后余量充足。

         注意: XML 注释里不能出现连续两个减号, 所以上图用了点线。 -->

    <model name="pillar_0">
      <static>true</static>
      <pose>0 6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>0 -6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>8 4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>8 -4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>-8 4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_5">
      <static>true</static>
      <pose>-8 -4 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_6">
      <static>true</static>
      <pose>0 9 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.5</radius><length>3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_n">
      <static>true</static>
      <pose>5.0 4.75 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 6.5 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 6.5 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_east_s">
      <static>true</static>
      <pose>5.0 -4.75 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 6.5 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 6.5 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west_n">
      <static>true</static>
      <pose>-5.0 4.75 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 6.5 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 6.5 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="wall_west_s">
      <static>true</static>
      <pose>-5.0 -4.75 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 6.5 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 6.5 3.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
